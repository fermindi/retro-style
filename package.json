{
  "name": "retro-style-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Retro/vintage design system inspired by classic computing hardware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fermindi/retro-style.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}
