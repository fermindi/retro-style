{
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "mono": {
        "$value": ["Courier New", "Courier", "monospace"],
        "$description": "Primary retro monospace font"
      },
      "sans": {
        "$value": ["system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
        "$description": "System sans-serif fallback"
      }
    },
    "fontSize": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px - Extra small" },
      "sm": { "$value": "0.875rem", "$description": "14px - Small" },
      "base": { "$value": "1rem", "$description": "16px - Base size" },
      "lg": { "$value": "1.125rem", "$description": "18px - Large" },
      "xl": { "$value": "1.25rem", "$description": "20px - Extra large" },
      "2xl": { "$value": "1.5rem", "$description": "24px - 2x large" },
      "3xl": { "$value": "1.875rem", "$description": "30px - 3x large" },
      "4xl": { "$value": "2.25rem", "$description": "36px - 4x large" }
    },
    "fontWeight": {
      "$type": "number",
      "normal": { "$value": 400, "$description": "Regular weight" },
      "medium": { "$value": 500, "$description": "Medium weight" },
      "semibold": { "$value": 600, "$description": "Semibold weight" },
      "bold": { "$value": 700, "$description": "Bold weight" }
    },
    "lineHeight": {
      "$type": "number",
      "none": { "$value": 1, "$description": "No extra line height" },
      "tight": { "$value": 1.25, "$description": "Tight spacing" },
      "snug": { "$value": 1.375, "$description": "Snug spacing" },
      "normal": { "$value": 1.5, "$description": "Normal spacing" },
      "relaxed": { "$value": 1.625, "$description": "Relaxed spacing" },
      "loose": { "$value": 2, "$description": "Loose spacing" }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tighter": { "$value": "-0.05em", "$description": "Tighter tracking" },
      "tight": { "$value": "-0.025em", "$description": "Tight tracking" },
      "normal": { "$value": "0em", "$description": "Normal tracking" },
      "wide": { "$value": "0.025em", "$description": "Wide tracking" },
      "wider": { "$value": "0.05em", "$description": "Wider tracking" },
      "widest": { "$value": "0.1em", "$description": "Widest tracking" }
    }
  }
}
